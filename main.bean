; ledger-domain-assets
; 本地 Beancount 账本模板，供 ledger-domain-core 使用。
;
; 写入规则：
; - Core 只写 trans/main.bean；交易、balance、pad 都由 Core 追加。
; - main.bean 与 account/*.bean 是账户/结构配置，不作为日常写入目标。
; - 不要手动编辑 trans/main.bean。

; 1. 账本元数据
option "title" "我的账本"
option "operating_currency" "CNY"
option "documents" "document"

2010-01-01 custom "fava-option" "language" "zh_CN"
2010-01-01 custom "fava-option" "auto-reload" "true"
2010-01-01 custom "fava-option" "default-page" "balance_sheet/"
2010-01-01 custom "fava-option" "indent" "2"
2010-01-01 custom "fava-option" "sidebar-show-queries" "7"

; 2. 账户
include "account/assets.bean"
include "account/liabilities.bean"
include "account/expenses.bean"
include "account/income.bean"
include "account/equity.bean"

; 3. 交易：Core 的唯一写入目标
include "trans/main.bean"
