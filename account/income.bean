; 主动收入
2026-11-17 open Income:Active:Business CNY  ; 企业经营收入
  alias: "企业经营"
2026-11-17 open Income:Active:Freelance CNY  ; 兼职/自由职业
  alias: "兼职收入"
2026-11-17 open Income:Active:Salary CNY  ; 工资收益
  alias: "工资"
2026-11-17 open Income:Active:Salary:Subsidy:Meal CNY  ; 餐补
  alias: "餐补"
2026-11-17 open Income:Active:Salary:Subsidy:Provident CNY  ; 公积金
  alias: "公积金"
2026-11-17 open Income:Active:Salary:Deduct CNY  ; 扣款(迟到、早退、旷工等)
  alias: "工资扣款"

; 被动收入
2026-11-17 open Income:Investment CNY  ; 被动收益(利息、股息、资本得利、租金、版权/专利费等）
  alias: "投资收益"
2026-11-17 open Income:Investment:Interest CNY,COIN  ; 利息收入（银行、债券）
  alias: "利息收入"
2026-11-17 open Income:Investment:Dividends CNY     ; 股息收入（股票、基金分红）
  alias: "股息收入"
2026-11-17 open Income:Investment:CapitalGains CNY  ; 资本利得（卖出投资品的盈利部分）
  alias: "资本利得"
2026-11-17 open Income:Investment:Rental CNY        ; 租金收入（房产、设备出租）
  alias: "租金收入"
2026-11-17 open Income:Investment:Royalty CNY     ; 版税/专利收入
  alias: "版税收入"

; 转移收入
2026-11-17 open Income:Transfer:Personal  ; 来自个人的转移（礼物、红包）
  alias: "个人转移"
2026-11-17 open Income:Transfer:Relationship CNY  ; 人情往来
  alias: "人情收入"
2026-11-17 open Income:Transfer:Organizational  ; 来自组织/企业的转移（机构红包、优惠抵扣、补偿）
  alias: "组织转移"
2026-11-17 open Income:Transfer:Governmental  ; 来自政府的转移（补助、津贴、退税）
  alias: "政府补助"

; 暂无分类
2026-11-17 open Income:Other
  alias: "其他收入"
